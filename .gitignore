# 忽略 build 目录（适用于大多数构建系统，如 CMake、Makefile 等）
build/
build-debug/
build-release/

# 忽略常见的编译生成文件
*.o
*.a
*.so
*.dll
*.exe
*.out
*.obj
*.lib
*.lo
*.la

# 忽略 IDE 生成的文件（如 VS Code、CLion、Visual Studio 等）
.vscode/
.idea/
*.sln
*.vcxproj
*.vcxproj.user

# 忽略 CMake 生成的文件
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake

# 忽略调试文件
*.dbg
*.pdb

# 忽略日志文件
*.log